# ML_ANN_Paper_Bot v2.1 — every key is read by bot/botconfig.py and range-checked
# at boot. Values below are the deployment described in README.md; the defaults
# baked into botconfig.py differ in places, so set these explicitly.

# --- persistence: MUST point inside the mounted Railway volume.
# Without a volume every trade record is destroyed on each redeploy.
DB_PATH=/data/bot.db

# --- universe & strategy
PAIRS=BTC,ETH,SOL,LINK,NEAR,SUI,APT,HYPE,PEPE,WIF,DOGE
TIMEFRAME=8h
EXIT_TIMEFRAME=1m
VENUE=okx
INST_TYPE=SWAP
STRATEGIES=donchian
PARAMS_FILE=params.json
MARKET_FILTER=align
MARKET_FILTER_SYMBOL=BTC
MODE=paper

# --- account & risk
STARTING_EQUITY=1000
RISK_PER_TRADE=0.0075
LEVERAGE=4
MAX_OPEN=5
MAX_GROSS_NOTIONAL=2.0
MAX_NOTIONAL_PER_TRADE=0.6
SAME_SYMBOL_LOCK=true
MAX_CORRELATED=3

# --- kill switches
MAX_DAILY_LOSS=0.06
MAX_DRAWDOWN_HALT=0.25
MAX_CONSECUTIVE_LOSSES=8
STALE_DATA_HALT_MIN=90

# --- costs
TAKER_FEE=0.0005
SLIP_ENTRY_BPS=2
SLIP_STOP_BPS=5
APPLY_FUNDING=true

# --- operations
POLL_SECONDS=30            # loop interval while holding an open position
IDLE_POLL_SECONDS=60       # loop interval while flat
SNAPSHOT_SECONDS=300       # equity-curve write interval
HEARTBEAT_HOURS=12

# --- API budget (v2.1). The feed only refetches when a bar has actually
# closed, so these bound the once-per-bar sweep, not a per-cycle poll.
API_RATE_PER_SEC=6         # token bucket; OKX allows 20, validator caps at 15
API_WORKERS=6              # concurrency for the batch refresh
LOG_LEVEL=INFO
PAUSED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
