# Ignore python cache
__pycache__/
*.py[cod]
*$py.class
.venv/

# Ignore environment variables and local databases
.env
*.db

# Research data artifacts (frozen datasets are large; manifest stays in git)
research/data/frozen/*.parquet
research/output/

# DO NOT ignore the model artifacts
!artifacts/ann_mtf_v3_model.joblib
!artifacts/ann_mtf_v3_meta.json
